{
  "name": "daily-work-log",
  "displayName": "Daily Work Log",
  "description": "Daily work log management with date-based organization, form collection, and AI summary generation",
  "version": "0.1.12",
  "packageManager": "yarn@3.8.1",
  "publisher": "acongm",
  "repository": {
    "type": "git",
    "url": "https://github.com/Acongm/fill-work-code.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:daily-work-log.openForm",
    "onCommand:daily-work-log.showSummary",
    "onCommand:daily-work-log.generateAI",
    "onCommand:daily-work-log.sendEmail",
    "onCommand:daily-work-log.editConfig",
    "onCommand:daily-work-log.openProfile",
    "onCommand:daily-work-log.package",
    "onCommand:daily-work-log.packageForce",
    "onCommand:daily-work-log.packageStatus",
    "onCommand:daily-work-log.releasePatch",
    "onCommand:daily-work-log.releaseMinor",
    "onCommand:daily-work-log.releaseMajor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "daily-work-log.openForm",
        "title": "Open Daily Work Log",
        "category": "Daily Work Log"
      },
      {
        "command": "daily-work-log.showSummary",
        "title": "Show Monthly Summary",
        "category": "Daily Work Log"
      },
      {
        "command": "daily-work-log.generateAI",
        "title": "Generate AI Report",
        "category": "Daily Work Log"
      },
      {
        "command": "daily-work-log.sendEmail",
        "title": "Send Work Report Email",
        "category": "Daily Work Log"
      },
      {
        "command": "daily-work-log.editConfig",
        "title": "Edit Configuration",
        "category": "Daily Work Log"
      },
      {
        "command": "daily-work-log.openProfile",
        "title": "Open Personal Center",
        "category": "Daily Work Log"
      },
      {
        "command": "daily-work-log.package",
        "title": "Package VSIX",
        "category": "Daily Work Log"
      },
      {
        "command": "daily-work-log.packageForce",
        "title": "Package VSIX (Force Overwrite)",
        "category": "Daily Work Log"
      },
      {
        "command": "daily-work-log.packageStatus",
        "title": "Show Package Status",
        "category": "Daily Work Log"
      },
      {
        "command": "daily-work-log.releasePatch",
        "title": "Release Patch Version",
        "category": "Daily Work Log"
      },
      {
        "command": "daily-work-log.releaseMinor",
        "title": "Release Minor Version",
        "category": "Daily Work Log"
      },
      {
        "command": "daily-work-log.releaseMajor",
        "title": "Release Major Version",
        "category": "Daily Work Log"
      }
    ],
    "configuration": {
      "title": "Daily Work Log",
      "properties": {
        "dailyWorkLog.storagePath": {
          "type": "string",
          "default": "~/.work-logs",
          "description": "Path to store work log files"
        },
        "dailyWorkLog.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save changes"
        },
        "dailyWorkLog.aiEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable AI report generation"
        },
        "dailyWorkLog.showCompletedInput": {
          "type": "boolean",
          "default": true,
          "description": "Show Completed input field"
        },
        "dailyWorkLog.showPlanInput": {
          "type": "boolean",
          "default": true,
          "description": "Show Plan input field"
        },
        "dailyWorkLog.showBlockersInput": {
          "type": "boolean",
          "default": true,
          "description": "Show Blockers input field"
        },
        "dailyWorkLog.showNotesInput": {
          "type": "boolean",
          "default": true,
          "description": "Show Notes input field"
        },
        "dailyWorkLog.showGitlogInput": {
          "type": "boolean",
          "default": true,
          "description": "Show GitLog input field"
        },
        "dailyWorkLog.showAilogInput": {
          "type": "boolean",
          "default": false,
          "description": "Show AILog input field"
        },
        "dailyWorkLog.showGitCommitInput": {
          "type": "boolean",
          "default": false,
          "description": "Show GitCommit input field"
        },
        "dailyWorkLog.showOriginUrlInput": {
          "type": "boolean",
          "default": false,
          "description": "Show Origin URL input field"
        },
        "dailyWorkLog.dailySyncFieldVisibility": {
          "type": "boolean",
          "default": false,
          "description": "Sync daily form field visibility with panel settings"
        },
        "dailyWorkLog.previewEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Open a side preview panel for daily and monthly reports"
        }
      }
    },
    "keybindings": [
      {
        "command": "daily-work-log.openForm",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorFocus || explorerViewletFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.mjs && node scripts/build-webview.mjs",
    "build:webview": "node scripts/build-webview.mjs",
    "install:all": "npm install && npm --prefix web install",
    "build:all": "npm run compile",
    "watch": "node esbuild.mjs --watch",
    "watch:webview": "npm --prefix web run build -- --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "node scripts/release/package.mjs",
    "package:force": "node scripts/release/package.mjs --force",
    "release:status": "node scripts/release/status.mjs",
    "release": "node scripts/release/index.mjs patch",
    "release:patch": "node scripts/release/index.mjs patch",
    "release:minor": "node scripts/release/index.mjs minor",
    "release:major": "node scripts/release/index.mjs major",
    "release:app": "node scripts/release-app.mjs",
    "release:app:status": "node scripts/release/status.mjs",
    "compile-tests": "tsc -p tsconfig.json --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint -c eslint.config.mjs src web/src",
    "test": "vscode-test",
    "publish:marketplace": "npm run compile && npx vsce publish --no-yarn --no-dependencies --allow-missing-repository --skip-duplicate"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.2",
    "lerna": "^8.1.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "markdown-it": "^14.1.0"
  }
}